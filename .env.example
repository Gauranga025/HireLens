# HireLens environment variables
# Backend: copy to backend/.env when starting uvicorn from backend/.
# Frontend: copy the frontend section to frontend/.env.local.
# Never commit real .env files or production credentials.

# --- Backend application ---
APP_NAME=AI Resume Screening Backend
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1

# JSON array of allowed browser origins. Change for deployed frontend URLs.
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- PostgreSQL ---
# The application builds SQLAlchemy DATABASE_URL from these POSTGRES_* values.
# A separate DATABASE_URL environment variable is intentionally not read.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=resume_screening
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_dev_password

# Disposable database URL used only by backend tests (never by the app).
# The database name must end in _test and must not be the main database.
# TEST_DATABASE_URL=postgresql+asyncpg://resume_user:resume_dev_password@localhost:5432/resume_screening_test

# --- Uploaded-file storage ---
# Relative paths are resolved from the API process working directory.
# For containers or platform deployments, set this to a mounted persistent path.
UPLOAD_STORAGE_DIR=storage/uploads

# --- Semantic model runtime ---
# The standard model is pinned to a verified snapshot. Override only after
# validating artifacts in the target environment. Set revision to "main" to
# intentionally follow the upstream branch (less reproducible).
# SEMANTIC_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
# SEMANTIC_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
# Standard Hugging Face cache controls. Point HF_HOME at a persistent volume.
# HF_HOME=/path/to/persistent/huggingface-cache
# HF_HUB_OFFLINE=0
# HF_HUB_DISABLE_TELEMETRY=1

# --- Frontend (put these in frontend/.env.local) ---
# This value is public because Next.js EXPOSEs NEXT_PUBLIC_* to the browser.
# Never put secrets in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
