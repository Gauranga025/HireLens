# Database Configuration (PostgreSQL)
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control

# PostgreSQL Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=resume_screening
POSTGRES_USER=resume_user
POSTGRES_PASSWORD=resume_dev_password

# Database URL (for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://resume_user:resume_dev_password@localhost:5432/resume_screening

# Note: The password above is for development only.
# Change it for production deployments.
